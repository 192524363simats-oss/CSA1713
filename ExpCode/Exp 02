def is_safe(board, row, col):
    # Check the same column
    for i in range(row):
        if board[i] == col:
            return False

        # Check diagonals
        if abs(board[i] - col) == abs(i - row):
            return False

    return True


def solve_queens(board, row):
    # All 8 queens are placed
    if row == 8:
        return True

    for col in range(8):
        if is_safe(board, row, col):
            board[row] = col

            if solve_queens(board, row + 1):
                return True

            # Backtrack
            board[row] = -1

    return False


# Initialize board
board = [-1] * 8

# Solve the problem
if solve_queens(board, 0):
    print("Solution:")

    for row in range(8):
        for col in range(8):
            if board[row] == col:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()
else:
    print("No solution exists.")
