from collections import deque

def solve_puzzle(start, goal):
    queue = deque([(start, [])])
    visited = {start}

    moves = {
        0: [-1, -3],      # up, left
        1: [-1, 1, -3],   # up, right, left
        2: [-1, 3],       # up, down
        3: [-3, 3, -1],   # up, down, left
        4: [-3, 3, -1, 1],
        5: [-3, 3, 1],
        6: [-1, 3],
        7: [-1, 1, 3],
        8: [-1, 3]
    }

    while queue:
        state, path = queue.popleft()

        if state == goal:
            return path + [state]

        zero = state.index(0)
        row, col = divmod(zero, 3)

        for move in moves[zero]:
            new_zero = zero + move

            if 0 <= new_zero < 9:
                new_row, new_col = divmod(new_zero, 3)

                # Make sure the move doesn't wrap around the board
                if abs(row - new_row) + abs(col - new_col) != 1:
                    continue

                new_state = list(state)
                new_state[zero], new_state[new_zero] = (
                    new_state[new_zero],
                    new_state[zero]
                )
                new_state = tuple(new_state)

                if new_state not in visited:
                    visited.add(new_state)
                    queue.append((new_state, path + [state]))

    return None


# 0 represents the blank space
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

solution = solve_puzzle(start, goal)

if solution:
    print("Solution found!\n")

    for step in solution:
        print(step[0:3])
        print(step[3:6])
        print(step[6:9])
        print()
else:
    print("No solution exists.")
