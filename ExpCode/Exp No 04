from itertools import permutations

letters = 'SENDMORY'
digits = '0123456789'

for p in permutations(digits, len(letters)):
    d = dict(zip(letters, p))

    if d['S'] == '0' or d['M'] == '0':
        continue

    SEND = int(''.join(d[x] for x in 'SEND'))
    MORE = int(''.join(d[x] for x in 'MORE'))
    MONEY = int(''.join(d[x] for x in 'MONEY'))

    if SEND + MORE == MONEY:
        print("SEND =", SEND)
        print("MORE =", MORE)
        print("MONEY =", MONEY)
        break
