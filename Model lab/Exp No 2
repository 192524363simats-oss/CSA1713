
import random

cities = ['A', 'B', 'C', 'D']

distance = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

def route_distance(route):
    total = 0
    for i in range(len(route)):
        a = route[i]
        b = route[(i + 1) % len(route)]
        total += distance[a][b]
    return total

population = [
    random.sample(range(4), 4)
    for _ in range(20)
]

for generation in range(100):
    population.sort(key=route_distance)

    new_population = population[:5]

    while len(new_population) < 20:
        parent = random.choice(population[:10])
        child = parent[:]

        a, b = random.sample(range(4), 2)
        child[a], child[b] = child[b], child[a]

        new_population.append(child)

    population = new_population

best_route = min(population, key=route_distance)

print("Shortest Route:")
print(" -> ".join(cities[i] for i in best_route),
      "->", cities[best_route[0]])

print("Shortest Distance:", route_distance(best_route))
